<?xml version="1.0" encoding="utf-8"?>
<!-- The assistant reaches Ollama on the user's own computer, which serves plain http on port 11434
     at an address only the user knows (a LAN IP), so the app's own requests may use cleartext.
     The dApp is unaffected: it runs in Chrome, which applies its own HTTPS rules. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
